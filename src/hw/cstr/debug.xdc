connect_debug_port u_ila_0/probe10 [get_nets [list fofb/gth_reset_tx_done]]
create_debug_port u_ila_0 probe
set_property PROBE_TYPE DATA_AND_TRIGGER [get_debug_ports u_ila_0/probe11]
